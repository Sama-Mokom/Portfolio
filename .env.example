# Omit for local previews. Set to the actual HTTPS production origin before launch.
SITE_URL=
# Optional Search Console HTML-tag verification token (the value after content=).
GOOGLE_SITE_VERIFICATION=
# Optional Formspree HTTPS endpoint. Without this, contact prepares an email draft.
CONTACT_FORM_ENDPOINT=
# Optional Umami Cloud website ID (public config, loaded only when VERCEL_ENV=production).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
