{
  "name": "mokom-portfolio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write app components content lib styles tests scripts *.json *.ts *.mts *.mjs README.md docs",
    "format:check": "prettier --check app components content lib styles tests scripts *.json *.ts *.mts *.mjs README.md docs",
    "test": "vitest run",
    "test:e2e": "node scripts/playwright.mjs",
    "test:production": "node scripts/test-production.mjs",
    "test:performance": "node scripts/lighthouse.mjs",
    "resume:pdf": "node scripts/export-resume.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "chrome-launcher": "1.2.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "29.1.1",
    "lighthouse": "13.5.0",
    "prettier": "3.9.8",
    "typescript": "^6.0.3",
    "vitest": "5.0.1"
  }
}
